    "vike": "^0.4.245",
    "vite": "^8.1.0",
    "voca": "^1.4.1",
    "vue": "^3.5.24",
    "vue-draggable-next": "^2.3.0",
    "vue-i18n": "^10.0.8",
    "vue-next-masonry": "^1.1.3"

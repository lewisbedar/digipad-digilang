    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.24",
    "@vue/server-renderer": "^3.5.24",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "bcrypt": "6.0.0",
    "check-disk-space": "^3.4.0",

    "cleandb": "cross-env NODE_ENV=production node server/nettoyer-db.js",
    "migrate-acl": "cross-env NODE_ENV=production node server/migrer-acl-s3.js",
    "maintenance": "cross-env NODE_ENV=production node server/maintenance.js"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
